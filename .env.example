# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Ahrefs ─────────────────────────────────────────────────
AHREFS_API_KEY=your_ahrefs_api_key_here

# ── SEMrush (optional) ─────────────────────────────────────
SEMRUSH_API_KEY=your_semrush_api_key_here

# ── Google OAuth / Service Account ─────────────────────────
# Path to your downloaded service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json

# ── Google Docs export (optional) ──────────────────────────
# The ID of the Google Drive folder where reports will be saved
GDOCS_FOLDER_ID=your_google_drive_folder_id_here
